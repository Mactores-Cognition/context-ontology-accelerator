# ─── Ontology Engine environment ──────────────────────────────────────────
#
# Copy this file to .env in your deployment or shell-rc, fill in the values
# for your AWS account and provisioned resources, then source it before
# running the server, scripts, or tests.

# ── Backend selection ──────────────────────────────────────────────────────
# opensearch_neptune  → OpenSearch Serverless (vectors) + Neptune DB (graph)
# na_only             → Neptune Analytics for both
WORKBENCH_BACKEND=opensearch_neptune

# ── Backend A: Neptune Analytics (na_only) ─────────────────────────────────
NA_GRAPH_ID=<your-na-graph-id>
NA_ENDPOINT=https://<your-na-graph-id>.<region>.neptune-graph.amazonaws.com
NA_REGION=us-east-1

# ── Backend B: OpenSearch Serverless vectors ───────────────────────────────
OSS_ENDPOINT=https://<your-aoss-collection>.<region>.aoss.amazonaws.com
OSS_REGION=us-east-1
OSS_INDEX=ontology-engine-embeddings
OSS_DIMENSIONS=1024

# ── Backend B: Neptune DB graph ────────────────────────────────────────────
NDB_ENDPOINT=https://<your-neptune-cluster>.cluster-<id>.<region>.neptune.amazonaws.com:8182
NDB_REGION=us-east-1
NDB_IAM_AUTH=true
# Base under which per-namespace ontology graphs live.
# Resulting URI: {base}/{ns}/{quoted_ontology_id} — one named graph per
# ontology. There is no separate catalog graph.
NDB_GRAPH_URI_BASE=https://ontology-engine.local
# Deprecated (still read for backward compat): NDB_GRAPH_URI=https://ontology-engine.local/graph/catalog

# ── Bedrock embeddings (both backends) ─────────────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
BEDROCK_EMBED_DIMENSIONS=1024

# ── Bedrock guardrails (optional security layer) ───────────────────────────
# SSM parameter path holding the Bedrock guardrail id. When set, content
# filtering / prompt-injection interception is applied to LLM calls (enrichment
# and ontology constraint inference). Optional — if unset, LLM calls proceed
# without guardrail interception.
# GUARDRAIL_SSM_PARAM=/coa/bedrock/guardrail-id

# ── DynamoDB (job metadata + proposals, backend-independent) ───────────────
DYNAMODB_TABLE=<your-dynamodb-table>
DYNAMODB_REGION=us-east-1

# ── Data-catalog sidecar ───────────────────────────────────────────────────
# When running the test-fixture data-catalog service on the default port:
DATA_CATALOG_URL=http://localhost:8003

# ── Induction output ───────────────────────────────────────────────────────
INDUCE_OUTPUT_DIR=./output/induce

# ── LLM (document induction and RIGOR strategy) ────────────────────────────
LLM_MODEL_ID=us.amazon.nova-pro-v1:0
LLM_REGION=us-east-1

# ── Tests (override DATA_CATALOG_URL + DYNAMODB_TABLE for test isolation) ──
TEST_DATA_CATALOG_URL=http://localhost:8003
TEST_DYNAMODB_TABLE=<your-test-dynamodb-table>

# ── Integration tests (required for `pytest -m integ`) ─────────────────────
# Backend gate — set to opensearch_neptune to enable AOSS integration tests
TEST_LIVE_BACKEND=opensearch_neptune
# AOSS endpoint — same as OSS_ENDPOINT (used by test fixtures independently)
TEST_OSS_ENDPOINT=https://<your-aoss-collection>.<region>.aoss.amazonaws.com
# AOSS collection name (for data access policy validation tests)
TEST_OSS_COLLECTION_ID=<your-collection-name>

# ── AWS environment (ensures SigV4 signing uses correct region) ────────────
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ── Deployment context ─────────────────────────────────────────────────────
# Environment name — used to derive S3 bucket names (coa-${env}-ontology-artifacts-${account})
SCL_ENVIRONMENT=dev
# Ontology artifacts S3 bucket — proposal turtle files are stored here.
# If unset, derived from SCL_ENVIRONMENT + current AWS account ID.
ONTOLOGY_ARTIFACTS_BUCKET=coa-<env>-ontology-artifacts-<account-id>

# ── Induction job liveness (OOM-orphan recovery) ───────────────
# Watchdog heartbeat interval (seconds). The induction worker bumps the job's
# updated_at this often so a long-but-alive run is never mistaken for an
# orphan by the stale sweep. Default: 45.
INDUCTION_HEARTBEAT_SECONDS=45
# Age (seconds) after which a non-terminal induction job with no live worker is
# swept to "failed" so polls terminate and namespace deletion self-heals.
# Default: 3600 (1h — induction is long-running).
INDUCTION_JOB_STALE_SECONDS=3600
# Table batch size for streaming fusion during induction. Bounds peak memory
# by processing tables in batches. Default: 500 tables/batch (~270 MB peak).
# Lower this if you hit OOM during large-catalog inductions.
INDUCER_TABLE_BATCH_SIZE=500
